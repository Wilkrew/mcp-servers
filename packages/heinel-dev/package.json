{
  "name": "heinel-dev-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Ask your AI assistant about Filip Heinel's work, from the public content of heinel.dev",
  "license": "MIT",
  "bin": {
    "heinel-dev-mcp": "src/stdio.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/stdio.ts",
    "serve": "node --experimental-strip-types src/http.ts",
    "export-site": "tsx scripts/export-site.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
